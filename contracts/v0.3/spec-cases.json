{
  "schemaVersion": "bug-dreamer/spec-cases/v1",
  "positive": [
    "contracts/v0.3/seeds/pass.json",
    "contracts/v0.3/seeds/candidate.json",
    "contracts/v0.3/seeds/marker-forgery.json",
    "contracts/v0.3/seeds/kind-flip.json",
    "contracts/v0.3/seeds/two-steps.json",
    "contracts/v0.3/seeds/retry-delay.json"
  ],
  "negative": [
    {
      "path": "contracts/v0.3/seeds/negative-duplicate-key.json",
      "expectedKind": "rejected-schema",
      "expectedMessage": "Duplicate JSON key"
    },
    {
      "path": "contracts/v0.3/seeds/negative-unknown-action.json",
      "expectedKind": "rejected-catalog",
      "expectedMessage": "Unknown action"
    },
    {
      "path": "contracts/v0.3/seeds/negative-forward-binding.json",
      "expectedKind": "rejected-policy",
      "expectedMessage": "missing or forward-referenced"
    },
    {
      "path": "contracts/v0.3/seeds/negative-policy-field.json",
      "expectedKind": "rejected-schema",
      "expectedMessage": "unknown field"
    },
    {
      "path": "contracts/v0.3/seeds/negative-empty-actors.json",
      "expectedKind": "rejected-schema",
      "expectedMessage": "actor count"
    },
    {
      "path": "contracts/v0.3/seeds/negative-binding-type.json",
      "expectedKind": "rejected-policy",
      "expectedMessage": "Binding type mismatch"
    },
    {
      "path": "contracts/v0.3/seeds/negative-invariant-outcome.json",
      "expectedKind": "rejected-policy",
      "expectedMessage": "not applicable to the final tx.run outcome"
    },
    {
      "path": "contracts/v0.3/seeds/negative-unsafe-integer.json",
      "expectedKind": "rejected-schema",
      "expectedMessage": "timeoutMs must be a safe non-negative integer"
    },
    {
      "path": "contracts/v0.3/seeds/negative-retry-budget.json",
      "expectedKind": "rejected-policy",
      "expectedMessage": "maxAttempts exceeds the retry budget"
    }
  ]
}
